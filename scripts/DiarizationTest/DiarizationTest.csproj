    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.11.3" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.19.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\WsprPc\Services\Diarization\ModelDownloader.cs" Link="Services\ModelDownloader.cs" />
    <Compile Include="..\..\WsprPc\Services\Diarization\SherpaDiarizationService.cs" Link="Services\SherpaDiarizationService.cs" />
    <Compile Include="..\..\WsprPc\Services\Diarization\AudioFileLoader.cs" Link="Services\AudioFileLoader.cs" />
    <Compile Include="..\..\WsprPc\Models\DiarizationSegment.cs" Link="Models\DiarizationSegment.cs" />
  </ItemGroup>

</Project>
