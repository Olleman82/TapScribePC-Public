<Window x:Class="WsprPc.BatchExperimentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skapa Experiment" 
        Width="500" Height="650" 
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        ResizeMode="CanResize">
  
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="Skapa Experiment" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
      <TextBlock x:Name="SubtitleText" Text="Skapa varianter för: Filnamn.mp3" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
    </StackPanel>

    <!-- 1. Thresholds -->
    <GroupBox Grid.Row="1" Header="1. Känslighet (Diarization Threshold)" Margin="0,0,0,16" Padding="10">
      <StackPanel>
        <TextBlock Text="Ange värden separerade med komma (t.ex. 1.0, 1.1, 1.2)" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
        <TextBlock Text="Lågt värde (0.1) = Fler talare. Högt värde (2.0) = Färre talare." FontSize="11" Foreground="{DynamicResource TextSecondary}" Opacity="0.7" Margin="0,0,0,8" />
        <TextBox x:Name="ThresholdInput" Text="1.0, 1.1, 1.2" Padding="8" />
      </StackPanel>
    </GroupBox>

    <!-- 2. Speaker Count -->
    <GroupBox Grid.Row="2" Header="2. Antal Talare" Margin="0,0,0,16" Padding="10">
      <StackPanel>
        <RadioButton x:Name="RadioSpeakersAuto" Content="Auto (Låt AI avgöra)" IsChecked="True" GroupName="Speakers" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="RadioSpeakersFixed" Content="Tvinga antal:" GroupName="Speakers" VerticalAlignment="Center" />
          <TextBox x:Name="SpeakerCountInput" Width="50" Margin="10,0,0,0" Padding="4" IsEnabled="{Binding IsChecked, ElementName=RadioSpeakersFixed}" Text="2" HorizontalContentAlignment="Center" MaxLength="2" />
        </StackPanel>
      </StackPanel>
    </GroupBox>

    <!-- 3. Pitch Protection -->
    <GroupBox Grid.Row="3" Header="3. Könsskydd (Pitch Protection)" Margin="0,0,0,16" Padding="10">
      <StackPanel>
        <RadioButton x:Name="RadioPitchOn" Content="PÅ (Standard)" IsChecked="True" GroupName="Pitch" Margin="0,0,0,8" ToolTip="Förhindrar ihopslagning av manliga och kvinnliga röster." />
        <RadioButton x:Name="RadioPitchOff" Content="AV" GroupName="Pitch" Margin="0,0,0,8" ToolTip="Tillåter friare ihopslagning av röster oavsett pitch." />
        <RadioButton x:Name="RadioPitchBoth" Content="Skapa BÅDA (Dubblar antalet varianter)" GroupName="Pitch" ToolTip="Skapar en variant med PÅ och en med AV för varje tröskelvärde." />
      </StackPanel>
    </GroupBox>

    <!-- Summary & Generate -->
    <Grid Grid.Row="5">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
        <TextBlock x:Name="SummaryText" Text="Genererar 3 varianter" Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Avbryt" Click="Cancel_Click" Margin="0,0,10,0" Padding="12,6" />
        <Button Content="Generera Experiment" Click="Generate_Click" Style="{StaticResource PrimaryButton}" Padding="16,8" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
