<Window x:Class="WsprPc.MemoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minne" Height="320" Width="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/tapscribe.ico">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <TextBlock Width="100" VerticalAlignment="Center" Text="Titel" Foreground="{DynamicResource TextPrimary}" />
      <TextBox x:Name="TitleBox" Width="360" />
    </StackPanel>

    <TextBlock Grid.Row="1" Margin="0,10,0,4" Text="Innehåll" Foreground="{DynamicResource TextPrimary}" />
    <TextBox Grid.Row="2" x:Name="ContentBox" AcceptsReturn="True" TextWrapping="Wrap" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="CancelButton" Width="90" Margin="0,0,8,0" Content="Avbryt" />
      <Button x:Name="OkButton" Width="90" Content="Spara" Style="{StaticResource PrimaryButton}" />
    </StackPanel>
  </Grid>
</Window>
