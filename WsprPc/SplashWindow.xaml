<Window x:Class="WsprPc.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TapScribe PC"
        Width="720"
        Height="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">
  <Border CornerRadius="18" Background="#F5F7FB" BorderBrush="#E5E7EB" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Margin="18" CornerRadius="14" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1">
        <Grid>
          <Image x:Name="SplashImage" Stretch="Uniform" />
          <TextBlock x:Name="FallbackText"
                     Text="TapScribe PC"
                     FontFamily="Bahnschrift"
                     FontSize="28"
                     FontWeight="SemiBold"
                     Foreground="#111827"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Visibility="Collapsed" />
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="0,0,0,16" HorizontalAlignment="Center">
        <TextBlock Text="Startar TapScribe..." FontFamily="Bahnschrift" Foreground="#5B6472" />
        <TextBlock x:Name="VersionText" FontFamily="Bahnschrift" Foreground="#9CA3AF" FontSize="12" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
