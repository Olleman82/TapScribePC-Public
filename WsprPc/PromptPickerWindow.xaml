<Window x:Class="WsprPc.PromptPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Välj prompt" Height="360" Width="420" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/TapScribe;component/Assets/tapscribe.ico"
        Topmost="True"
        ShowActivated="True"
        ShowInTaskbar="True"
        WindowStyle="ToolWindow">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ListBox x:Name="PromptListBox" Grid.Row="0" MouseDoubleClick="PromptListBox_OnMouseDoubleClick" />

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="CancelButton" Width="90" Margin="0,0,8,0" Content="Avbryt" />
      <Button x:Name="OkButton" Width="90" Content="Använd" />
    </StackPanel>
  </Grid>
</Window>
