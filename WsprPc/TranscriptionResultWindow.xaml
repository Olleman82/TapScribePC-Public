<Window x:Class="WsprPc.TranscriptionResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transkribering" 
        Width="500" Height="400" 
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    
    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock x:Name="TitleText" Text="Transkribering" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
      <TextBlock x:Name="StatsText" Text="Tid: 0:00 • Hastighet: -" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
    </StackPanel>
    
    <!-- Content -->
    <TextBox x:Name="TranscriptionTextBox" 
             Grid.Row="1" 
             IsReadOnly="True" 
             AcceptsReturn="True" 
             TextWrapping="Wrap" 
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Disabled"
             Background="{DynamicResource CardBg}" 
             Foreground="{DynamicResource TextPrimary}"
             BorderBrush="{DynamicResource BorderColor}"
             BorderThickness="1" 
             Padding="12" 
             FontFamily="Segoe UI" 
             FontSize="13" />
    
    <!-- Footer -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button x:Name="CopyButton" Content="Kopiera text" Padding="14,7" Click="CopyButton_Click" />
        <Button x:Name="SaveButton" Content="Spara till fil..." Margin="12,0,0,0" Padding="14,7" Click="SaveButton_Click" />
      </StackPanel>
      <Button x:Name="CloseButton" Content="Stäng" HorizontalAlignment="Right" Padding="14,7" Click="CloseButton_Click" />
    </Grid>
  </Grid>
</Window>
