<Window x:Class="WsprPc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TapScribe PC" Height="600" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/tapscribe.ico">

  
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    
    <!-- UPDATE BANNER -->
    <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed"
            Background="{DynamicResource AccentBrush}" Padding="12,8">
      <DockPanel>
        <Button x:Name="UpdateBannerButton" DockPanel.Dock="Right" 
                Content="Ladda ner" Padding="12,4"
                Background="White" Foreground="{DynamicResource AccentBrush}"
                FontWeight="Medium" Cursor="Hand" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="🔔" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White" />
          <TextBlock x:Name="UpdateBannerText" FontSize="13" FontWeight="Medium" 
                     Foreground="White" VerticalAlignment="Center" 
                     Text="Ny version finns tillgänglig." />
        </StackPanel>
      </DockPanel>
    </Border>
    
    <!-- HEADER -->
    <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <StackPanel Orientation="Horizontal" Grid.Column="0">
          <Image Source="pack://application:,,,/Assets/tapscribe.ico" Width="32" Height="32" Margin="0,0,10,0" />
          <TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Text="TapScribe PC" />
        </StackPanel>
        
        <Border Grid.Column="1" HorizontalAlignment="Center" Background="{DynamicResource AccentLight}" 
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="14,5">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusBadgeDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
            <TextBlock x:Name="StatusText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="Väntar" />
          </StackPanel>
        </Border>
        
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <ToggleButton x:Name="DarkModeToggle" Style="{StaticResource FlipSwitch}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Mörkt tema" />
          <TextBlock Text="🌙" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Button x:Name="FaqButton" Content="❓" Padding="8,4" Margin="0,0,6,0" ToolTip="Vanliga frågor" />
          <Button x:Name="AboutButton" Content="Om" Padding="10,4" />
        </StackPanel>
      </Grid>
    </Border>
    
    <!-- TABS -->
    <TabControl Grid.Row="2" Margin="12,8,12,0" BorderThickness="0" Background="Transparent">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Padding" Value="14,6" />
          <Setter Property="FontSize" Value="14" />
          <Setter Property="FontWeight" Value="Medium" />
          <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                  <ContentPresenter ContentSource="Header" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>
      
      <!-- TAB 1: Snabbstart -->
      <TabItem Header="Snabbstart">
        <StackPanel Margin="0,12,0,0">
          
          <!-- INIT STATUS BANNER (for model download / autotune) -->
          <Border x:Name="InitStatusBanner" Visibility="Collapsed" Background="{DynamicResource AccentLight}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
              <ProgressBar x:Name="InitProgressBar" Height="4" Margin="0,8,0,0" IsIndeterminate="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock x:Name="InitStatusText" Text="Optimerar för din dator..." VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource AccentForeground}" />
            </StackPanel>
          </Border>
          
          <!-- Row 1: Guide + Model + Tip -->
          <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Effect="{StaticResource CardShadow}" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              
              <!-- 1-2-3 Guide -->
              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentLight}" Margin="0,0,6,0">
                  <TextBlock Text="1" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="GuideHoldText" VerticalAlignment="Center" Margin="0,0,16,0" xml:space="preserve"><Run FontWeight="Medium">Håll </Run><Run Foreground="{DynamicResource TextSecondary}">tangent</Run></TextBlock>
                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentLight}" Margin="0,0,6,0">
                  <TextBlock Text="2" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock VerticalAlignment="Center" Margin="0,0,16,0"><Run FontWeight="Medium">Prata</Run></TextBlock>
                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentLight}" Margin="0,0,6,0">
                  <TextBlock Text="3" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock VerticalAlignment="Center"><Run FontWeight="Medium">Släpp</Run><Run Foreground="{DynamicResource TextSecondary}"> → text!</Run></TextBlock>
              </StackPanel>
              
              <!-- Model status -->
              <TextBlock x:Name="ModelStateText" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12" Text="Modell: Whisper tiny" />
            </Grid>
          </Border>
          
          <!-- Row 2: Hotkeys | AI Settings -->
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <!-- Hotkeys -->
            <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Effect="{StaticResource CardShadow}" Margin="0,0,5,0">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="14" Text="Snabbtangenter" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <TextBlock Text="Direkt:" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <ComboBox x:Name="DirectHotkeyCombo" Margin="0,0,16,0" SelectionChanged="DirectHotkeyCombo_SelectionChanged" />
                  <TextBlock Text="AI:" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <ComboBox x:Name="AiHotkeyCombo" SelectionChanged="AiHotkeyCombo_SelectionChanged" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <CheckBox x:Name="AutoPasteCheckBox" Content="Autoklistra" Margin="0,0,20,0" ToolTip="Klistrar in texten automatiskt efter transkribering." />
                  <CheckBox x:Name="StartWithWindowsCheckBox" Content="Starta med Windows" ToolTip="Startar automatiskt vid inloggning." />
                </StackPanel>
              </StackPanel>
            </Border>
            
            <!-- AI Settings -->
            <Border Grid.Column="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Effect="{StaticResource CardShadow}" Margin="5,0,0,0">
              <StackPanel>
                <TextBlock x:Name="AiSectionTitle" FontWeight="SemiBold" FontSize="14" Text="AI-bearbetning" Margin="0,0,0,6" />
                <CheckBox x:Name="UseDefaultPromptCheckBox" Content="Använd standardprompt" ToolTip="Använder alltid din valda standardprompt för AI-läget." />
                <CheckBox x:Name="UseAutoPromptCheckBox" Content="Använd senast valda" ToolTip="Kommer ihåg vilken prompt du senast använde." />
                <TextBlock x:Name="DefaultPromptText" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" Text="Standard: (ingen)" />
              </StackPanel>
            </Border>
          </Grid>
          
          <!-- Row 3: Promptar | Minne -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <!-- Promptar -->
            <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Effect="{StaticResource CardShadow}" Margin="0,0,5,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock FontWeight="SemiBold" FontSize="14" Text="Promptar" />
                  <Button x:Name="PromptInfoButton" Style="{StaticResource InfoBtn}" Content="?" />
                </StackPanel>
                <ListBox x:Name="PromptListBox" Height="90" FontSize="13" Margin="0,0,0,8" />
                <WrapPanel>
                  <Button x:Name="AddPromptButton" Content="Lägg till" Margin="0,0,4,0" />
                  <Button x:Name="EditPromptButton" Content="Redigera" Margin="0,0,4,0" />
                  <Button x:Name="DeletePromptButton" Content="Ta bort" Margin="0,0,4,0" />
                  <Button x:Name="SetDefaultPromptButton" Content="★ Std" ToolTip="Sätt som standard" Margin="0,0,4,0" />
                  <Button x:Name="ClearDefaultPromptButton" Content="☆" ToolTip="Rensa standard" />
                </WrapPanel>
              </StackPanel>
            </Border>
            
            <!-- Minne -->
            <Border Grid.Column="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Effect="{StaticResource CardShadow}" Margin="5,0,0,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock FontWeight="SemiBold" FontSize="14" Text="Minne" />
                  <Button x:Name="MemoryInfoButton" Style="{StaticResource InfoBtn}" Content="?" />
                </StackPanel>
                <ListBox x:Name="MemoryListBox" Height="90" FontSize="13" Margin="0,0,0,8" />
                <WrapPanel>
                  <Button x:Name="AddMemoryButton" Content="Lägg till" Margin="0,0,4,0" />
                  <Button x:Name="EditMemoryButton" Content="Redigera" Margin="0,0,4,0" />
                  <Button x:Name="DeleteMemoryButton" Content="Ta bort" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </Grid>
          
        </StackPanel>
      </TabItem>
      
      <!-- TAB 2: Inställningar -->
      <TabItem Header="Inställningar">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          
          <!-- Left: Model + AutoTune -->
          <StackPanel Grid.Column="0" Margin="0,0,5,0">
            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Effect="{StaticResource CardShadow}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="14" Text="Whisper-modell" Margin="0,0,0,8" />
                <ComboBox x:Name="ModelPresetCombo" Width="Auto" Margin="0,0,0,8">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayLabel}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="PresetNoteText" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <Button x:Name="DownloadModelButton" Style="{StaticResource PrimaryButton}" Content="Ladda ner" HorizontalAlignment="Left" />
                <ProgressBar x:Name="DownloadProgressBar" Margin="0,8,0,0" Height="5" />
                <TextBlock x:Name="DownloadStatusText" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" Text="Väntar" />
              </StackPanel>
            </Border>
            
            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Effect="{StaticResource CardShadow}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="14" Text="Prestanda (auto-tune)" Margin="0,0,0,8" />
                <TextBlock x:Name="AutoTuneStatusText" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" Text="Optimerar för din dator." />
                <ProgressBar x:Name="AutoTuneProgressBar" Height="5" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="AutoTuneButton" Content="Kör auto-tune" />
                  <TextBlock x:Name="AutoTuneDetailText" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="~1 min" />
                </StackPanel>
                <Expander Header="Manuell trådinställning (avancerat)" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0">
                  <StackPanel Margin="4,4,0,0">
                    <TextBlock Text="⚠️ Ändra endast om du vet vad du gör. Felaktigt antal trådar kan sänka prestandan eller göra datorn seg." 
                               FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Manuellt antal trådar:" VerticalAlignment="Center" FontSize="12" />
                      <TextBox x:Name="ManualThreadsTextBox" Grid.Column="1" FontSize="12" VerticalAlignment="Center" ToolTip="Lämna tomt för att använda Auto‑tune resultat." />
                    </Grid>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
          </StackPanel>
          
          <!-- Right: VAD + API -->
          <StackPanel Grid.Column="1" Margin="5,0,0,0">
            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Effect="{StaticResource CardShadow}" Margin="0,0,0,10">
              <StackPanel>
                <CheckBox x:Name="EnableVadCheckBox" Content="Aktivera realtids-transkribering (VAD)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="Transkriberar löpande vid tystnadsetektering vilket ger ökad hastighet på längre talsekvenser. Avstängd (Baseline) ger bäst kvalitet men längre väntetid i slutet." 
                           FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Känslighet:" VerticalAlignment="Center" />
                  <TextBox x:Name="SilenceThresholdTextBox" Grid.Column="1" FontSize="13" ToolTip="Lägre=känsligare. Standard: 0,05" />
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Min tystnad (sek):" VerticalAlignment="Center" />
                  <TextBox x:Name="SilenceDurationTextBox" Grid.Column="1" FontSize="13" ToolTip="Standard: 1,0" />
                </Grid>
              </StackPanel>
            </Border>
            
            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Effect="{StaticResource CardShadow}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="14" Text="API-nycklar" Margin="0,0,0,8" />
                <TextBlock Text="Gemini" FontSize="12" Margin="0,0,0,3" />
                <PasswordBox x:Name="GeminiApiKeyBox" FontSize="13" Margin="0,0,0,8" />
                <TextBlock Text="OpenAI" FontSize="12" Margin="0,0,0,3" />
                <PasswordBox x:Name="OpenAiApiKeyBox" FontSize="13" />
              </StackPanel>
            </Border>

            <Expander Header="Manuell modell-länk" FontSize="13" IsExpanded="False">
              <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                <StackPanel>
                  <TextBlock Text="URL:" FontSize="12" Margin="0,0,0,3" />
                  <TextBox x:Name="ModelUrlTextBox" FontSize="13" Margin="0,0,0,6" />
                  <TextBlock Text="Filnamn:" FontSize="12" Margin="0,0,0,3" />
                  <TextBox x:Name="ModelFileNameTextBox" FontSize="13" />
                </StackPanel>
              </Border>
            </Expander>
          </StackPanel>
        </Grid>
      </TabItem>
      
      <!-- TAB 3: Filer (Transcribe Audio Files) -->
      <TabItem Header="Filer">
        <StackPanel Margin="0,12,0,0">
          
          <!-- Model Download Banner -->
          <Border x:Name="DiarizationModelBanner" Visibility="Collapsed" Background="{DynamicResource AccentLight}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="Modeller för talarigenkänning saknas" FontWeight="SemiBold" Foreground="{DynamicResource AccentForeground}" />
              <TextBlock Text="Klicka nedan för att ladda ner (~150 MB). Detta behövs bara en gång." FontSize="12" Foreground="{DynamicResource AccentForeground}" Margin="0,4,0,8" />
              <StackPanel Orientation="Horizontal">
                <Button x:Name="DownloadDiarizationModelsButton" Content="Ladda ner modeller" Style="{StaticResource PrimaryButton}" />
                <ProgressBar x:Name="DiarizationModelDownloadProgress" Width="200" Height="6" Margin="12,0,0,0" Visibility="Collapsed" />
              </StackPanel>
              <TextBlock x:Name="DiarizationModelDownloadStatus" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          
          <!-- File Selection Card -->
          <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Effect="{StaticResource CardShadow}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="Transkribera ljudfil" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
              <TextBlock Text="Ladda upp en mötesinspelning (MP3, WAV, M4A) för transkribering med talarigenkänning." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12" />
              
              <!-- File Picker Row -->
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="SelectAudioFileButton" Content="Välj fil..." Padding="12,6" />
                <TextBlock x:Name="SelectedAudioFileText" Text="Ingen fil vald" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
              
              <!-- Options Row -->
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Antal talare (valfritt):" VerticalAlignment="Center" FontSize="13" />
                <ComboBox x:Name="SpeakerCountCombo" Width="80" Margin="10,0,0,0" SelectedIndex="0">
                  <ComboBoxItem Content="Auto" />
                  <ComboBoxItem Content="2" />
                  <ComboBoxItem Content="3" />
                  <ComboBoxItem Content="4" />
                  <ComboBoxItem Content="5+" />
                </ComboBox>
              </StackPanel>
              
              <!-- Start Button -->
              <StackPanel Orientation="Horizontal">
                <Button x:Name="StartFileTranscriptionButton" Content="Starta transkribering" Style="{StaticResource PrimaryButton}" IsEnabled="False" Padding="14,8" />
                <Button x:Name="CancelFileTranscriptionButton" Content="Avbryt" Visibility="Collapsed" Margin="10,0,0,0" Padding="12,6" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Performance Info Card -->
          <Border Background="{DynamicResource AccentLight}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1,1,1,3" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="ℹ️" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Prestanda och kapacitet" FontWeight="SemiBold" Foreground="{DynamicResource AccentForeground}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock FontSize="12" Foreground="{DynamicResource AccentForeground}" TextWrapping="Wrap" LineHeight="18">
                Denna funktion är mycket resurskrävande och drar mycket kapacitet från datorn. 
                Beroende på din dators prestanda kan tidsåtgången variera från dubbelt så lång som ljudfilen 
                till flera gånger snabbare än realtid.
              </TextBlock>
            </StackPanel>
          </Border>

          
          <!-- Progress Card -->
          <Border x:Name="FileTranscriptionProgressPanel" Visibility="Collapsed" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Effect="{StaticResource CardShadow}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock x:Name="FileTranscriptionStatusText" Text="Bearbetar..." FontWeight="Medium" Margin="0,0,0,8" />
              <ProgressBar x:Name="FileTranscriptionProgressBar" Height="8" />
              <TextBlock x:Name="FileTranscriptionPercentText" Text="0%" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" HorizontalAlignment="Right" />
            </StackPanel>
          </Border>
          
          <!-- Result Card -->
          <Border x:Name="FileTranscriptionResultPanel" Visibility="Collapsed" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Effect="{StaticResource CardShadow}">
            <StackPanel>
              <TextBlock Text="Resultat" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
              <TextBox x:Name="FileTranscriptionResultText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBg}" BorderThickness="1" Padding="8" FontFamily="Consolas" FontSize="12" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="CopyFileTranscriptionButton" Content="Kopiera text" Padding="12,6" />
                <Button x:Name="SaveFileTranscriptionButton" Content="Spara till fil" Margin="10,0,0,0" Padding="12,6" />
              </StackPanel>
            </StackPanel>
          </Border>
          
        </StackPanel>
      </TabItem>
    </TabControl>
    
    <!-- FOOTER -->
    <Border Grid.Row="3" Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Image Source="pack://application:,,,/Assets/aiolle_transparent.png" Width="20" Height="20" Margin="0,0,8,0" />
          <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="Olle Söderqvist" />
        </StackPanel>
        <TextBlock x:Name="HotkeyText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="24,0,0,0" Text="Direkt: F8 • AI: F9" />
        <Button x:Name="SaveSettingsButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Spara" Padding="16,6" Visibility="Collapsed" />
        <TextBlock />
      </DockPanel>
    </Border>
    
    <!-- Hidden -->
    <TextBlock x:Name="LastResultText" Visibility="Collapsed" />
    <Expander x:Name="AdvancedExpander" Visibility="Collapsed" />
  </Grid>
</Window>
