<Window x:Class="WsprPc.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historik" Height="406" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/tapscribe.ico">

  <Window.Resources>
    <!-- Dark Calendar Style -->
    <Style x:Key="DarkCalendarStyle" TargetType="Calendar">
      <Setter Property="Background" Value="{DynamicResource CardBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    
    <Style x:Key="DarkCalendarDayButtonStyle" TargetType="CalendarDayButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
        <Trigger Property="IsToday" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentLight}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    
    <Style x:Key="DarkCalendarButtonStyle" TargetType="CalendarButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    
    <Style x:Key="DarkDatePickerStyle" TargetType="DatePicker">
      <Setter Property="Background" Value="{DynamicResource ControlBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="CalendarStyle" Value="{StaticResource DarkCalendarStyle}" />
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock FontSize="18" FontWeight="SemiBold" Text="📋 Historik" Foreground="{DynamicResource TextPrimary}" />
      <TextBlock Foreground="{DynamicResource TextSecondary}" Text="Alla transkriberings- och AI-resultat" />
    </StackPanel>

    <!-- Filter-rad -->
    <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" 
            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
      <WrapPanel>
        <!-- Sökruta -->
        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
          <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox x:Name="SearchBox" Width="180" Padding="6,4"
                   Background="{DynamicResource WindowBg}"
                   Foreground="{DynamicResource TextPrimary}"
                   BorderBrush="{DynamicResource BorderColor}"
                   ToolTip="Sök i output" />
        </StackPanel>

        <!-- Datumfilter -->
        <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
          <TextBlock Text="Datum:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondary}" />
          <ComboBox x:Name="DateFilterCombo" Width="100" SelectedIndex="0"
                    Background="{DynamicResource CardBg}">
            <ComboBoxItem Content="Alla" Tag="all" />
            <ComboBoxItem Content="Idag" Tag="today" />
            <ComboBoxItem Content="7 dagar" Tag="7days" />
            <ComboBoxItem Content="30 dagar" Tag="30days" />
            <ComboBoxItem Content="Anpassat" Tag="custom" />
          </ComboBox>
        </StackPanel>

        <!-- DatePickers (visas vid "Anpassat") -->
        <StackPanel x:Name="CustomDatePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,8,0">
          <TextBlock Text="Från:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextSecondary}" />
          <DatePicker x:Name="FromDatePicker" Width="110" Style="{StaticResource DarkDatePickerStyle}" />
          <TextBlock Text="Till:" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{DynamicResource TextSecondary}" />
          <DatePicker x:Name="ToDatePicker" Width="110" Style="{StaticResource DarkDatePickerStyle}" />
        </StackPanel>

        <!-- Typfilter -->
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Typ:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondary}" />
          <ComboBox x:Name="TypeFilterCombo" Width="120" SelectedIndex="0"
                    Background="{DynamicResource CardBg}">
            <ComboBoxItem Content="Alla" Tag="all" />
            <ComboBoxItem Content="Transkribering" Tag="transcription" />
            <ComboBoxItem Content="AI" Tag="ai" />
          </ComboBox>
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- DataGrid -->
    <DataGrid x:Name="HistoryDataGrid" Grid.Row="2"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              IsReadOnly="True"
              SelectionMode="Extended"
              SelectionUnit="FullRow"
              GridLinesVisibility="Horizontal"
              HeadersVisibility="Column"
              Background="{DynamicResource CardBg}"
              Foreground="{DynamicResource TextPrimary}"
              BorderBrush="{DynamicResource BorderColor}"
              RowBackground="{DynamicResource CardBg}"
              AlternatingRowBackground="{DynamicResource WindowBg}"
              CanUserSortColumns="True">

      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="DataGridColumnHeader">
          <Setter Property="Background" Value="{DynamicResource HeaderBg}" />
          <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
          <Setter Property="Padding" Value="8,6" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
          <Setter Property="BorderThickness" Value="0,0,1,1" />
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="DataGridColumnHeader">
                <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                  <StackPanel Orientation="Horizontal">
                    <ContentPresenter VerticalAlignment="Center" />
                    <Path x:Name="SortArrow" Margin="4,0,0,0" VerticalAlignment="Center"
                          Fill="{DynamicResource TextSecondary}" Visibility="Collapsed" />
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="SortDirection" Value="Ascending">
                    <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                    <Setter TargetName="SortArrow" Property="Data" Value="M 0 4 L 4 0 L 8 4 Z" />
                  </Trigger>
                  <Trigger Property="SortDirection" Value="Descending">
                    <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                    <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 4 4 L 8 0 Z" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </DataGrid.ColumnHeaderStyle>

      <DataGrid.CellStyle>
        <Style TargetType="DataGridCell">
          <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Padding" Value="6,4" />
          <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="{DynamicResource AccentLight}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </DataGrid.CellStyle>

      <DataGrid.Columns>
        <!-- Datum -->
        <DataGridTextColumn Header="Datum ↕" Binding="{Binding DateDisplay}" Width="95" SortMemberPath="Timestamp" />

        <!-- Tid -->
        <DataGridTextColumn Header="Tid ↕" Binding="{Binding TimeDisplay}" Width="75" SortMemberPath="Timestamp" />

        <!-- Typ -->
        <DataGridTextColumn Header="Typ" Binding="{Binding TypeDisplay}" Width="50" SortMemberPath="Type" />

        <!-- Output -->
        <DataGridTextColumn Header="Output ↕" Binding="{Binding Output}" Width="*" SortMemberPath="Output">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              <Setter Property="ToolTip" Value="{Binding Output}" />
              <Setter Property="MaxWidth" Value="500" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>

        <!-- Kopiera-knapp -->
        <DataGridTemplateColumn Header="📋" Width="40" CanUserSort="False" CanUserResize="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="📋"
                      Click="CopyRowButton_Click"
                      Background="Transparent"
                      BorderThickness="0"
                      Cursor="Hand"
                      ToolTip="Kopiera denna output"
                      FontSize="14"
                      Padding="4,2" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Footer -->
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Markera alla -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <CheckBox x:Name="SelectAllCheckBox" Content="Markera alla" 
                  Foreground="{DynamicResource TextPrimary}" 
                  VerticalAlignment="Center" />
        <TextBlock x:Name="ItemCountText" VerticalAlignment="Center" Margin="16,0,0,0"
                   Foreground="{DynamicResource TextSecondary}" FontSize="12" />
      </StackPanel>

      <!-- Knappar -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="DeleteSelectedButton" Content="Ta bort markerade" Padding="12,6" Margin="0,0,8,0" />
        <Button x:Name="ClearAllButton" Content="Ta bort alla" Padding="12,6" Margin="0,0,8,0" />
        <Button x:Name="CloseButton" Content="Stäng" Padding="12,6" Style="{StaticResource PrimaryButton}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
